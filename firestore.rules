rules_version = '2';

// Toute personne qui a ouvert l'app et entré un prénom obtient une session
// "anonyme" Firebase (pas besoin d'email ni de mot de passe). Ces règles
// autorisent TOUT utilisateur connecté (même anonymement) à lire et écrire
// le calendrier, la discussion et les réglages partagés — il n'y a pas de
// statut "admin" séparé, comme demandé.
//
// ⚠️ Ces règles ouvrent l'accès à quiconque a le lien de l'app et peut créer
// une session anonyme (donc potentiellement n'importe qui sur internet, pas
// seulement "le groupe"). Si tu veux limiter à un cercle précis de personnes,
// remplace l'auth anonyme par une connexion par e-mail/mot de passe et
// n'autorise que des e-mails choisis (demande-moi si tu veux cette variante).

service cloud.firestore {
  match /databases/{database}/documents {

    match /events/{eventId} {
      allow read, write: if request.auth != null;
    }

    match /messages/{messageId} {
      allow read, write: if request.auth != null;
    }

    match /app/{docId} {
      allow read, write: if request.auth != null;
    }

    match /members/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /lovitao/{childId} {
      allow read, write: if request.auth != null;
    }
  }
}
